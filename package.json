{
  "name": "pjserver",
  "version": "0.1.0",
  "description": "プロセカ民営公園の専属Botです。",
  "private": true,
  "type": "module",
  "main": "./dist/master.js",
  "bin": {
    "pjserver": "./dist/master.js"
  },
  "scripts": {
    "build": "tsx scripts/copy-static.ts && tsc -p tsconfig.json && tsc-alias",
    "build:prod": "tsx scripts/copy-static.ts && tsc -p tsconfig.build.json && tsc-alias",
    "lint": "eslint ./src --ext .ts",
    "lint:fix": "eslint ./src --ext .ts --fix",
    "format": "prettier ./src --check",
    "format:fix": "prettier ./src --write",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "copy-static": "tsx scripts/copy-static.ts",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AkatukiSora/pjserver-sys.git"
  },
  "author": "",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/AkatukiSora/pjserver-sys/issues"
  },
  "homepage": "https://github.com/AkatukiSora/pjserver-sys#readme",
  "lint-staged": {
    "*": [
      "eslint --fix"
    ],
    ".": [
      "prettier --write ."
    ]
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "discord.js": "^14.27.0",
    "dotenv": "^16.6.1",
    "fs-extra": "^11.4.0",
    "log4js": "^6.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/eslint": "^9.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.10",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "3.5.3",
    "tsc-alias": "^1.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "packageManager": "pnpm@10.11.0+sha512.6540583f41cc5f628eb3d9773ecee802f4f9ef9923cc45b69890fb47991d4b092964694ec3a4f738a420c918a333062c8b925d312f42e4f0c263eb603551f977",
  "overrides": {}
}
